{
  "uid": "hermes-flow",
  "title": "Hermes Flow — Agents, Skills, Gateways, Cron",
  "tags": ["hermes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "bargauge", "title": "Sessions per profile (multi-agent life)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "sum by (profile) (hermes_sessions_total)", "legendFormat": "{{profile}}" }],
      "fieldConfig": { "defaults": { "unit": "sessions" }, "overrides": [] }
    },
    {
      "id": 2, "type": "table", "title": "Sessions per model per profile",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "sum by (profile, model) (hermes_sessions_by_model_total)", "legendFormat": "{{profile}}/{{model}}", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": {}, "renameByName": { "profile": "Profile", "model": "Model", "Value": "Sessions" } } }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 3, "type": "bargauge", "title": "Skill usage — top 15 (all scopes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "topk(15, sum by (skill) (hermes_skill_uses_total))", "legendFormat": "{{skill}}" }],
      "fieldConfig": { "defaults": { "unit": "uses" }, "overrides": [] }
    },
    {
      "id": 4, "type": "table", "title": "Per-profile skill usage",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "sum by (skill, scope) (hermes_skill_uses_total)", "legendFormat": "{{scope}}/{{skill}}", "instant": true, "format": "table" }],
      "transformations": [{ "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Value", "desc": true }] } }, { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": {}, "renameByName": { "skill": "Skill", "scope": "Scope", "Value": "Uses" } } }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Skill use trends — top 8 / day",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "topk(8, sum by (skill) (increase(hermes_skill_uses_total[1d])))", "legendFormat": "{{skill}}" }],
      "fieldConfig": { "defaults": { "unit": "uses" }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Cron runs vs failures (24h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [
        { "expr": "sum(increase(hermes_cron_runs_total[1d]))", "legendFormat": "runs" },
        { "expr": "sum(increase(hermes_cron_failures_total[1d]))", "legendFormat": "failures" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 7, "type": "table", "title": "Cron health per job (runs / failures)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [
        { "expr": "sum by (job) (hermes_cron_runs_total)", "legendFormat": "runs", "instant": true, "format": "table" },
        { "expr": "sum by (job) (hermes_cron_failures_total)", "legendFormat": "failures", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": {}, "renameByName": { "job": "Job", "runs": "Runs", "failures": "Failures" } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Gateway log lines mentioning Matrix rooms (15m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "loki", "uid": "lokiuid" },
      "targets": [{ "expr": "sum by (source) (count_over_time({job=\"hermes\"} |~ \"matrix:!\" [15m]))", "legendFormat": "{{source}}" }],
      "fieldConfig": { "defaults": { "unit": "loglines" }, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "Gateway status (1 = active)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [
        { "expr": "hermes_gateway_up{unit=\"hermes-gateway\"}", "legendFormat": "default" },
        { "expr": "hermes_gateway_up{unit=\"hermes-gateway-guru\"}", "legendFormat": "guru" },
        { "expr": "hermes_gateway_up{unit=\"hermes-gateway-sniper\"}", "legendFormat": "sniper" }
      ],
      "fieldConfig": { "defaults": { "unit": "bool" }, "overrides": [] }
    }
  ]
}