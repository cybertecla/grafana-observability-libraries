{
  "uid": "hermes-overview",
  "title": "Hermes Multi-Agent Overview",
  "tags": ["hermes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spent today (USD)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "hermes_cost_usd_daily", "legendFormat": "today" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spent this week (USD)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "hermes_cost_usd_weekly", "legendFormat": "7d" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Spent this month (USD)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "hermes_cost_usd_monthly", "legendFormat": "30d" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spent all-time (USD)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "hermes_cost_usd_total", "legendFormat": "all" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cumulative OpenRouter spend (USD)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [{ "expr": "hermes_cost_usd_total", "legendFormat": "total" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Exporter health — poll age (s) & cumulative errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheusuid" },
      "targets": [
        { "expr": "time() - hermes_cost_last_success_timestamp_seconds", "legendFormat": "poll age (s)" },
        { "expr": "hermes_cost_exporter_errors_total", "legendFormat": "errors (total)" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Hermes log lines by file (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "lokiuid" },
      "targets": [
        {
          "expr": "sum by (filename) (count_over_time({job=\"hermes\"}[5m]))",
          "legendFormat": "{{filename}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error lines by file (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "loki", "uid": "lokiuid" },
      "targets": [
        {
          "expr": "sum by (filename) (count_over_time({job=\"hermes\"} |~ \"(?i)error\" [5m]))",
          "legendFormat": "{{filename}}"
        }
      ]
    }
  ]
}
